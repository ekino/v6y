# Working defaults below get the stack running locally with zero edits beyond
# the two source-control tokens further down. Change PSQL_DB_PASSWORD and
# JWT_SECRET before using this anywhere other people can reach.
PSQL_DB_HOST=localhost
PSQL_DB_NAME=v6y
PSQL_DB_USER=v6y
PSQL_DB_PASSWORD=v6y
# Port the services connect to. With the database bundled in docker-compose.yml
# this must stay 5432, which is where PostgreSQL listens inside the network.
PSQL_DB_PORT=5432
# Host port the bundled database is published on. Change this one, not
# PSQL_DB_PORT, when 5432 is already taken on your machine.
PSQL_DB_HOST_PORT=5432
# Optional: overrides PSQL_DB_* above with a single connection string when set.
# Leave empty (the default) so the PSQL_DB_* values above are used - setting it
# to a placeholder here would silently take priority over correct PSQL_DB_*
# values and break every database connection.
DATABASE_URL=

# Account the migrate job creates on first run (see db:seed). Log in with these
# once the stack is up.
SUPERADMIN_USERNAME=admin
SUPERADMIN_EMAIL=admin@v6y.local
SUPERADMIN_PASSWORD=changeme123

GITLAB_PRIVATE_TOKEN=
GITHUB_PRIVATE_TOKEN=

# Any non-empty value works for local dev; use a real random string elsewhere.
JWT_SECRET=dev-secret-change-me

V6Y_DEVOPS_API_PATH=/v6y/bfb-devops-auditor/
V6Y_DEVOPS_API_PORT=4005
V6Y_DEVOPS_ANALYSER_API_PATH=http://localhost:4005/v6y/bfb-devops-auditor/auditor/start-devops-auditor.json

V6Y_DYNAMIC_ANALYZER_API_PATH=/v6y/bfb-dynamic-auditor
V6Y_DYNAMIC_ANALYZER_API_PORT=4004

# 4002 is the port the main analyzer actually binds (ServerConfig default and the
# docker-compose mapping). 4005 belongs to the devops auditor above.
V6Y_MAIN_API_PATH=/v6y/bfb-main/
V6Y_MAIN_API_PORT=4002
V6Y_MAIN_ANALYZER_TRIGGER_API_PATH=http://localhost:4002/v6y/bfb-main/trigger-application-analysis.json
V6Y_MAIN_ANALYZER_SCHEDULE_API_PATH=http://localhost:4002/v6y/bfb-main/schedule-application-analysis.json

V6Y_STATIC_ANALYZER_API_PATH=/v6y/bfb-static-auditor/
V6Y_STATIC_ANALYZER_API_PORT=4003

V6Y_QUEUE_HOST=localhost
V6Y_QUEUE_PORT=6379
V6Y_QUEUE_PREFIX=v6y

# Timezone the scheduled audit cron patterns are evaluated in. Defaults to UTC so
# a schedule does not depend on the container's timezone; set it to the timezone
# the back office presets should read as (e.g. Europe/Paris).
V6Y_AUDIT_SCHEDULE_TIMEZONE=UTC

# Shared secret the BFF sends, and the main analyzer requires, on the internal
# endpoints that trigger and schedule an application analysis. Left empty, those
# endpoints stay open to anything that can reach the port.
V6Y_INTERNAL_API_SECRET=

# Audit notification emails. Delivery is off until V6Y_MAIL_SMTP_HOST is filled
# in, so a local stack never tries to reach a mail server; set it (and the
# credentials your provider requires) to turn the emails on. Set
# V6Y_MAIL_ENABLED=false to keep the emails off even with an SMTP host set.
V6Y_MAIL_ENABLED=true
V6Y_MAIL_SMTP_HOST=
V6Y_MAIL_SMTP_PORT=587
# Implicit TLS. Defaults to true on port 465 and false elsewhere (STARTTLS).
V6Y_MAIL_SMTP_SECURE=
V6Y_MAIL_SMTP_USER=
V6Y_MAIL_SMTP_PASSWORD=
V6Y_MAIL_FROM=Vitality <no-reply@v6y.local>
# When the daily audit digest is sent, in V6Y_AUDIT_SCHEDULE_TIMEZONE. Six cron
# fields: second minute hour dayOfMonth month dayOfWeek.
V6Y_DAILY_DIGEST_CRON=0 0 8 * * *
# Public URL of the `front` app, used to build the links inside the emails.
# Left empty, the emails are sent without deep links.
V6Y_PUBLIC_APP_URL=http://localhost:3000

V6Y_BFF_API_PATH=/v6y/graphql/
V6Y_BFF_API_PORT=4001

# Browser-facing GraphQL endpoint (ui-kit, front-bo). Absolute URL, or a path
# relative to the origin serving the app. Build-time only: next build inlines it
# into the browser bundle, so setting it on a running container has no effect on
# client-side code — the two front images have to be rebuilt to change it.
NEXT_PUBLIC_V6Y_BFF_PATH=/v6y/graphql
# Server-side only: internal address the `front` app's /v6y/graphql rewrite targets.
V6Y_BFF_PROXY_TARGET=http://localhost:4001/v6y/graphql/
# Browser-facing URL of the front-bo app, used by `front` to link over to it.
NEXT_PUBLIC_V6Y_FRONT_BO_PATH=http://localhost:3001
# Legacy alias still read by some tooling for the back office URL.
NEXT_PUBLIC_BACK_OFFICE_URL=http://localhost:4007
# Optional: enable Refine live subscriptions in front-bo only when a WS endpoint
# is available.
# NEXT_PUBLIC_V6Y_BFF_WS_PATH=ws://localhost:4001/v6y/graphql/
NEXTAUTH_URL=http://localhost:3001

# Host ports the two Next.js front apps are published on.
V6Y_FRONTEND_PORT=4006
V6Y_FRONTEND_BO_PORT=4007

# Figma MCP integration. Leave empty unless you use the Figma tooling locally.
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=

# Environment
NODE_ENV=development

# LiteLLM proxy used for AI-generated summary reports. Fill in your own key.
LITELLM_BASE_URL=https://litellm.ekino.com/
LITELLM_API_KEY=
LITELLM_MODEL=gpt-5.6-luna
LITELLM_TIMEOUT_MS=60000

# Docker Registry
# Leave REGISTRY empty for local builds, so images are named v6y-bff:latest etc.
# For docker-compose.deploy.yml, set it to the published registry (trailing
# slash required): REGISTRY=ghcr.io/ekino/
REGISTRY=
# latest tracks the main branch. Pin to sha-<short> or to a release tag for a
# reproducible deployment.
IMAGE_TAG=latest
