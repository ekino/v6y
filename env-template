PSQL_DB_HOST=localhost
PSQL_DB_NAME=x
PSQL_DB_USER=x
PSQL_DB_PASSWORD=x
# Port the services connect to. With the database bundled in docker-compose.yml
# this must stay 5432, which is where PostgreSQL listens inside the network.
PSQL_DB_PORT=5432
# Host port the bundled database is published on. Change this one, not
# PSQL_DB_PORT, when 5432 is already taken on your machine.
PSQL_DB_HOST_PORT=5432
DATABASE_URL=postgresql://user:password@localhost:port/database

SUPERADMIN_USERNAME=x
SUPERADMIN_EMAIL=x
SUPERADMIN_PASSWORD=x

GITLAB_PRIVATE_TOKEN=x
GITHUB_PRIVATE_TOKEN=x

JWT_SECRET=x

V6Y_DEVOPS_API_PATH=/v6y/bfb-devops-auditor/
V6Y_DEVOPS_API_PORT=4005
V6Y_DEVOPS_ANALYSER_API_PATH=http://localhost:4005/v6y/bfb-devops-auditor/auditor/start-devops-auditor.json

V6Y_DYNAMIC_ANALYZER_API_PATH=/v6y/bfb-dynamic-auditor
V6Y_DYNAMIC_ANALYZER_API_PORT=4004

# 4002 is the port the main analyzer actually binds (ServerConfig default and the
# docker-compose mapping). 4005 belongs to the devops auditor above.
V6Y_MAIN_API_PATH=/v6y/bfb-main/
V6Y_MAIN_API_PORT=4002
V6Y_MAIN_ANALYZER_TRIGGER_API_PATH=http://localhost:4002/v6y/bfb-main/trigger-application-analysis.json
V6Y_MAIN_ANALYZER_SCHEDULE_API_PATH=http://localhost:4002/v6y/bfb-main/schedule-application-analysis.json

V6Y_STATIC_ANALYZER_API_PATH=/v6y/bfb-static-auditor/
V6Y_STATIC_ANALYZER_API_PORT=4003

V6Y_QUEUE_HOST=localhost
V6Y_QUEUE_PORT=6379
V6Y_QUEUE_PREFIX=v6y

# Timezone the scheduled audit cron patterns are evaluated in. Defaults to UTC so
# a schedule does not depend on the container's timezone; set it to the timezone
# the back office presets should read as (e.g. Europe/Paris).
V6Y_AUDIT_SCHEDULE_TIMEZONE=UTC

# Shared secret the BFF sends, and the main analyzer requires, on the internal
# endpoints that trigger and schedule an application analysis. Left empty, those
# endpoints stay open to anything that can reach the port.
V6Y_INTERNAL_API_SECRET=

V6Y_BFF_API_PATH=/v6y/graphql/
V6Y_BFF_API_PORT=4001

# Browser-facing GraphQL endpoint (ui-kit, front-bo). Absolute URL, or a path
# relative to the origin serving the app. Build-time only: next build inlines it
# into the browser bundle, so setting it on a running container has no effect on
# client-side code — the two front images have to be rebuilt to change it.
NEXT_PUBLIC_V6Y_BFF_PATH=xxxx
# Server-side only: internal address the `front` app's /v6y/graphql rewrite targets.
V6Y_BFF_PROXY_TARGET=http://localhost:4001/v6y/graphql/
NEXTAUTH_URL=xxxx

# Docker Registry
# Leave REGISTRY empty for local builds, so images are named v6y-bff:latest etc.
# For docker-compose.deploy.yml, set it to the published registry (trailing
# slash required): REGISTRY=ghcr.io/ekino/
REGISTRY=
# latest tracks the main branch. Pin to sha-<short> or to a release tag for a
# reproducible deployment.
IMAGE_TAG=latest
