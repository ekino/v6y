{
    "$schema": "https://unpkg.com/knip@5/schema.json",
    "ignoreExportsUsedInFile": {
        "interface": true,
        "type": true
    },
    "ignoreDependencies": ["@prisma/client"],
    "ignoreBinaries": ["prisma"],
    "ignore": ["**/*.config.*", "**/vitest.setup.*", "**/setupTests.*", "**/test-mocks/**"],
    "tags": ["-lintignore"],
    "workspaces": {
        "v6y-apps/front*": {
            "entry": ["src/app/**/*.{ts,tsx}", "next.config.mjs"],
            "project": ["**/*.{ts,tsx}"],
            "ignoreDependencies": ["tailwindcss", "@tailwindcss/postcss"]
        },
        "v6y-apps/bfb-static-auditor": {
            "entry": ["src/index.ts", "src/workers/*.ts"],
            "project": ["src/**/*.{ts,js}"],
            "ignoreDependencies": ["jscpd", "lodash", "typhonjs-escomplex"]
        },
        "v6y-apps/bfb-main-analyzer": {
            "entry": ["src/index.ts", "src/workers/*.ts"],
            "project": ["src/**/*.{ts,js}"],
            "ignoreDependencies": ["express"]
        },
        "v6y-apps/bfb-*": {
            "entry": ["src/index.ts", "src/workers/*.ts"],
            "project": ["src/**/*.{ts,js}"]
        },
        "v6y-apps/bff": {
            "entry": ["src/index.ts"],
            "project": ["src/**/*.{ts,js}"],
            "ignoreDependencies": ["@as-integrations/express5"]
        },
        "v6y-apps/*": {
            "entry": ["src/index.ts"],
            "project": ["src/**/*.{ts,js}"]
        },
        "v6y-libs/notifications": {
            "entry": ["src/index.ts"],
            "project": ["src/**/*.ts"]
        },
        "v6y-libs/core-logic": {
            "ignoreDependencies": ["@types/adm-zip", "globals"]
        },
        "v6y-libs/ui-kit": {
            "ignoreDependencies": ["@refinedev/devtools"]
        },
        "v6y-libs/*": {}
    }
}
